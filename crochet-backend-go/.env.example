# Server Environment Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# Security Credentials
JWT_SECRET=super_secret_jwt_sign_key_change_me_in_production
ADMIN_API_KEY=admin_security_shared_passphrase_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# PostgreSQL Connection String (hosted instance: Supabase, Neon, RDS, etc.)
DATABASE_URL=yourdburl

# Razorpay API Credentials
RAZORPAY_KEY_ID=id
RAZORPAY_KEY_SECRET=secret
RAZORPAY_WEBHOOK_SECRET=your_configured_webhook_secret_here

# Cloud Object / Image Storage Credentials (AWS S3-compatible or Cloudinary)
AWS_ACCESS_KEY_ID=yourAwsAccessKeyId
AWS_SECRET_ACCESS_KEY=yourAwsSecretAccessKey
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-cute-crochet-images

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Resend API Email Service Credentials (for OTP / Orders)
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=CuteCrochet <noreply@craftingforyou.in>

# SMTP Configuration (for Contact Form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=craftingforyouofficial@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
